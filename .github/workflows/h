<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aran Dezayi | Game Developer</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * {margin:0; padding:0; box-sizing:border-box;}
        body {
            font-family: 'Roboto', sans-serif;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            color: #fff;
            scroll-behavior: smooth;
        }

        header {
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: url('https://images.unsplash.com/photo-1610658127791-0e9a24c4f5f1?auto=format&fit=crop&w=1470&q=80') no-repeat center center/cover;
            position: relative;
        }
        header::after {
            content:"";
            position:absolute;
            top:0; left:0;
            width:100%; height:100%;
            background: rgba(0,0,0,0.6);
        }
        header h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 3em;
            color: #f39c12;
            z-index: 1;
            margin-bottom: 10px;
        }
        header p {
            font-size: 1.2em;
            z-index: 1;
        }

        nav {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(20, 20, 35, 0.95);
            display: flex;
            justify-content: center;
            padding: 10px 0;
            z-index: 10;
            backdrop-filter: blur(5px);
        }
        nav a {
            color: #fff;
            margin: 0 20px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }
        nav a:hover {
            color: #f39c12;
        }

        section {
            padding: 80px 20px;
            max-width: 1200px;
            margin: auto;
        }
        h2 {
            text-align: center;
            color: #f39c12;
            margin-bottom: 40px;
            font-size: 2.2em;
        }

        /* About */
        #about p {
            font-size: 1.1em;
            line-height: 1.8;
            text-align: center;
            max-width: 800px;
            margin: auto;
            opacity: 0;
            transform: translateY(50px);
            transition: 0.8s ease-out;
        }
        #about p.visible { opacity: 1; transform: translateY(0); }

        /* Projects */
        .projects {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
        }
        .project-card {
            background: rgba(30, 30, 50, 0.8);
            padding: 20px;
            border-radius: 15px;
            width: 280px;
            text-align: center;
            transition: 0.4s;
        }
        .project-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 25px rgba(0,0,0,0.6);
        }
        .project-card h3 { color: #f39c12; margin-bottom: 10px; }
        .project-card p { font-size: 0.95em; line-height: 1.5; }

        /* Skills */
        .skills {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }
        .skill {
            background: rgba(30, 30, 50, 0.8);
            padding: 15px 20px;
            border-radius: 10px;
            font-weight: bold;
            font-size: 1em;
            transition: 0.3s;
        }
        .skill:hover { background: #f39c12; color: #000; }

        /* Contact */
        form {
            display: flex;
            flex-direction: column;
            max-width: 500px;
            margin: auto;
        }
        input, textarea {
            padding: 12px;
            margin-bottom: 15px;
            border-radius: 8px;
            border: none;
        }
        button {
            padding: 12px;
            background: #f39c12;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }
        button:hover { background: #e67e22; }

        footer {
            text-align: center;
            padding: 20px;
            background: rgba(20,20,35,0.9);
        }
    </style>
</head>
<body>

<nav>
    <a href="#about">About</a>
    <a href="#projects">Projects</a>
    <a href="#skills">Skills</a>
    <a href="#contact">Contact</a>
</nav>

<header>
    <h1>Aran Dezayi</h1>
    <p>Kurdish-Iraqi University Student & Game Developer</p>
</header>

<section id="about">
    <h2>About Me</h2>
    <p id="aboutText">Hi! I'm Aran Dezayi, a passionate Kurdish-Iraqi university student specialized in game development. I enjoy creating interactive worlds and bringing ideas to life using Unity and Unreal Engine. My goal is to build games that entertain, challenge, and inspire players around the world.</p>
</section>

<section id="projects">
    <h2>My Projects</h2>
    <div class="projects">
        <div class="project-card">
            <h3>Space Adventure</h3>
            <p>2D Unity game exploring outer space and defeating alien enemies.</p>
        </div>
        <div class="project-card">
            <h3>Racing Mania</h3>
            <p>3D racing game with realistic physics and challenging tracks.</p>
        </div>
        <div class="project-card">
            <h3>Puzzle Master</h3>
            <p>Logic puzzle game to challenge players’ problem-solving skills.</p>
        </div>
    </div>
</section>

<section id="skills">
    <h2>Skills</h2>
    <div class="skills">
        <div class="skill">C# Programming</div>
        <div class="skill">Unity Engine</div>
        <div class="skill">Unreal Engine</div>
        <div class="skill">Blender 3D</div>
        <div class="skill">Game Design</div>
    </div>
</section>

<section id="contact">
    <h2>Contact Me</h2>
    <form>
        <input type="text" placeholder="Your Name" required>
        <input type="email" placeholder="Your Email" required>
        <textarea rows="5" placeholder="Your Message" required></textarea>
        <button type="submit">Send Message</button>
    </form>
</section>

<footer>
    &copy; 2026 Aran Dezayi | Kurdish-Iraqi Game Developer
</footer>

<script>
    // Scroll animation for About
    const aboutText = document.getElementById('aboutText');
    window.addEventListener('scroll', () => {
        const rect = aboutText.getBoundingClientRect();
        if(rect.top < window.innerHeight - 100) {
            aboutText.classList.add('visible');
        }
    });
</script>

</body>
</html>
